<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="clearance_reservation.ForecastedHeader" t-inherit="stock.ForecastedHeader" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('col-md-auto', 'text-center')][1]" position="after">
            <div class="col-md-auto text-center">
                <div class="h3">
                    <span t-out="_formatFloat(this.props.docs.quantity_free)"/>
                </div>
                <div>Unreserved</div>
            </div>
        </xpath>
    </t>
</templates>
