<odoo>
    <record id="view_warehouse_form_clearance" model="ir.ui.view">
        <field name="name">stock.warehouse.form.clearance</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_resupply']" position="before">
                <group string="Clearance Reservation">
                    <field name="buffer_zone_location_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
