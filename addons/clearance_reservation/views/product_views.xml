<odoo>
    <record id="view_product_normal_form_bin_stock" model="ir.ui.view">
        <field name="name">product.product.form.bin.stock</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_bin_stock" type="object" class="oe_stat_button" icon="fa-map-marker">
                    <field name="bin_stock_total" widget="statinfo" string="Bin Stock"/>
                </button>
            </div>
            <!-- Native "On Hand" button shows qty_available, which also
                 counts stock already picked and sitting in WH/Output
                 awaiting shipment — not a "where do I find it on a bin"
                 figure. Only the DISPLAYED value is swapped to
                 bin_stock_reference_qty (same Stock-only scoping as the
                 Bin Stock button above); qty_available itself is left
                 completely untouched since it's relied on elsewhere
                 (pricing, reordering, other modules). -->
            <xpath expr="//button[@name='action_update_quantity_on_hand']//field[@name='qty_available']"
                   position="replace">
                <field name="bin_stock_reference_qty" nolabel="1" class="oe_inline"/>
            </xpath>
        </field>
    </record>
</odoo>
